MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority
DB_NAME=mindstore
PORT=8000

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://your-frontend-domain.com

# Cookie/session security
COOKIE_SECURE=true
COOKIE_SAMESITE=none
SESSION_DURATION_DAYS=7

# Optional hardening toggles
ENFORCE_ORIGIN_CHECK=true
ALLOW_NULL_ORIGIN_ON_MUTATIONS=false
ALLOW_HEADER_SESSION_TOKEN=false
MUTATION_RATE_LIMIT_MAX=120
REQUEST_BODY_LIMIT_BYTES=1048576
TRUST_PROXY=true

# Firebase Admin credentials (recommended)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
