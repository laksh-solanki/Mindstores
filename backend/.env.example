ENVIRONMENT=production
DB_NAME=mindstore
FIREBASE_PROJECT_ID=mindstore-2912
FIREBASE_WEB_API_KEY=replace_with_firebase_web_api_key
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://mindstores.vercel.app
ADMIN_EMAILS=admin@example.com
COOKIE_SECURE=true
COOKIE_SAMESITE=none
SESSION_DURATION_DAYS=7
ENFORCE_ORIGIN_CHECK=true
ALLOW_NULL_ORIGIN_ON_MUTATIONS=false
MUTATION_RATE_LIMIT_MAX=120
REQUEST_BODY_LIMIT_BYTES=1048576

# Use one database option.
MONGO_URL=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
# MONGO_ATLAS_DATA_API_URL=https://<region>.aws.data.mongodb-api.com/app/<app-id>/endpoint/data/v1
# MONGO_ATLAS_DATA_API_KEY=replace_with_atlas_data_api_key
MONGO_ATLAS_DATA_SOURCE=Cluster0
