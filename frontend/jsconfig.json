{
  "compilerOptions": {
    "allowJs": true,
    "target": "es5", // Deprecated, consider updating to a newer target like "es6" or "esnext"
    "module": "esnext",
    "baseUrl": "./", // Deprecated, consider removing or updating
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost"
    ],
    "ignoreDeprecations": "5.0"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}